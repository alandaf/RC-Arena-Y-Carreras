# Copia este archivo a "backend/.env.production" en el VPS y completa con valores reales.
# NUNCA commitees el archivo real con credenciales.

NODE_ENV=production
PORT=3001

# Debe coincidir con POSTGRES_USER/PASSWORD/DB del .env raíz usado por docker-compose.prod.yml
DATABASE_URL="postgresql://rcarena_user:cambia-esta-clave-por-una-segura@db:5432/rcarena"

FRONTEND_URL="https://tudominio.cl"

# SMTP real — MailHog no aplica en producción. Ejemplos: Resend, SendGrid, SES, tu proveedor de hosting.
SMTP_HOST=smtp.tuproveedor.cl
SMTP_PORT=587
SMTP_USER="usuario_smtp"
SMTP_PASS="clave_smtp"
EMAIL_FROM="RC Arena <no-reply@tudominio.cl>"
EMAIL_DUENO="dueno@tudominio.cl"

# Panel de administración (/admin). Genera el hash con:
#   docker compose exec backend node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE_REAL', 10))"
# y un JWT_SECRET propio con:
#   docker compose exec backend node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANTE: Docker Compose interpreta "$" dentro de env_file como inicio de
# variable. El hash de bcrypt siempre trae varios "$" (ej. $2a$10$...), así que
# hay que duplicarlos como "$$" o el hash queda truncado y el login nunca
# funciona. Ejemplo: si el hash generado es
#   $2a$10$ZLPGsssLjSfZs6xuDKZfaeHpaejP8W1dEuiSilB3nqks3PmwnTIci
# escríbelo aquí como:
#   $$2a$$10$$ZLPGsssLjSfZs6xuDKZfaeHpaejP8W1dEuiSilB3nqks3PmwnTIci
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH="reemplaza-con-el-hash-generado-duplicando-cada-$-como-$$"
JWT_SECRET="reemplaza-con-un-secreto-aleatorio-propio"
